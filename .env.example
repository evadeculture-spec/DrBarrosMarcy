# Ligação do papel da aplicação (sem BYPASSRLS, não é dono das tabelas).
DATABASE_URL=postgres://sf_app:mudar@localhost:5432/solicitaflow
# Ligação do dono do esquema: só para migrações, seed e ativar escritórios.
DATABASE_ADMIN_URL=postgres://sf_owner:mudar@localhost:5432/solicitaflow
# Nome do papel da aplicação (recebe as permissões nas migrações).
DATABASE_APP_ROLE=sf_app
# Escritório usado quando o endereço não tem subdomínio (ex.: localhost, *.vercel.app).
DEFAULT_ORG_SLUG=demo
# Palavra-passe dos utilizadores de demonstração criados por `npm run db:seed`.
SEED_DEMO_PASSWORD=
# "registo" guarda os envios na aplicação (sem email real).
ENVIO_MODO=registo
